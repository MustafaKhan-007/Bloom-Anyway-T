# --- Core ---------------------------------------------------------------
# "development" (default) or "production". Production turns on secure cookies
# + https and requires the few vars below. On Render this is auto-detected.
APP_ENV=development

# Optional. If unset, a persistent key is generated and stored in the database
# on first boot, so you don't have to manage one. To pin your own:
# python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# --- Database -------------------------------------------------------------
# Leave unset locally to use SQLite (firstlight-dev.db in the project root).
# On Render this is injected from the managed Postgres database. REQUIRED in
# production (the app refuses to start on ephemeral SQLite there).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Email (REQUIRED in production) ----------------------------------------
# Option A (recommended on Render): Brevo transactional HTTP API.
# Create an account at https://www.brevo.com → SMTP & API → API Keys.
BREVO_API_KEY=

# Optional. Transactional template IDs (Brevo → Transactional → Templates → #).
# General (#10): shared layout used for welcome, receipt, membership, cancel, etc.
#   Subject: {{ params.SUBJECT }}
#   Preview: {{ params.PREVIEW }}
#   Gold header: {{ params.HEADER }}
#   Title: {{ params.TITLE }}
#   Body: {{ params.BODY }}  (or {{ params.BODY_HTML }} if you allow HTML)
#   Button text: {{ params.BUTTON_TEXT }}
#   Button URL field: {{ params.BUTTON_URL }}
# Confirm (#3): 6-digit signup code — keep separate — {{ params.CODE }}
# BREVO_TEMPLATE_GENERAL=10
# BREVO_TEMPLATE_CONFIRM=3
# Optional absolute site URL for CTA links when sending outside a web request:
# PUBLIC_BASE_URL=https://www.bloomanyway.online
# Optional grace window shown in the decline email (default 3):
# MEMBERSHIP_GRACE_DAYS=3
# Legacy per-email template ids (only used if BREVO_TEMPLATE_GENERAL is unset/0):
# BREVO_TEMPLATE_WELCOME=2
# BREVO_TEMPLATE_RECEIPT=4
# BREVO_TEMPLATE_HEALING=5
# BREVO_TEMPLATE_CREATOR=6
# BREVO_TEMPLATE_CARD_DECLINED=7
# BREVO_TEMPLATE_CANCEL=8
# BREVO_TEMPLATE_NEWSLETTER=9

# Option B: any SMTP relay. Only used when BREVO_API_KEY is empty.
# Port 465 uses SSL, others STARTTLS. Leave empty in local dev to print emails
# to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# The "From" address. Must use a sender/domain verified in Brevo, e.g.
# Bloom Anyway <hello@yourdomain.com>.
# Contact-form messages go to the admin account claimed at /setup.
MAIL_FROM="Bloom Anyway <hello@example.com>"

# --- Cloudflare Turnstile (signup) -----------------------------------------
# Site key is the existing dashboard widget. Secret must match that widget —
# set TURNSTILE_SECRET in Render (never commit the value).
TURNSTILE_SITE_KEY=0x4AAAAAAEAGFowmHgyFM5Kf
TURNSTILE_SECRET=

# --- Stripe (courses, guides, memberships) ---------------------------------
# Dashboard → Developers → API keys / Webhooks.
# Webhook URL MUST use the canonical host (www), not the apex redirect:
#   https://www.bloomanyway.online/webhooks/stripe
# Apex bloomanyway.online returns Cloudflare 307 → Stripe marks delivery failed.
# After creating/editing that endpoint, copy its Signing secret (whsec_…) into
# STRIPE_WEBHOOK_SECRET on Render and redeploy — a secret from an old/apex
# endpoint returns 401 and Stripe keeps pending_webhooks > 0.
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         invoice.paid, invoice.payment_failed, charge.refunded,
#         customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: self-hosted shop files referenced by ShopPurchase.file_key
# Default when empty: instance/shop_files/
# SHOP_FILES_DIR=

# --- Daily.co (embedded support-group rooms) ---------------------------------
# API key: https://dashboard.daily.co/ → Developers
DAILY_API_KEY=
# Optional: used only for stub room URLs in local/tests (your Daily subdomain).
# DAILY_DOMAIN=bloomanyway
# Optional meeting length in minutes (default 30).
# DAILY_MEETING_DURATION=30
